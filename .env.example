# Public Supabase project configuration. The anon/publishable key is safe for
# the browser only because Row Level Security remains enabled.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only. Never prefix this value with NEXT_PUBLIC_. Normal user requests
# must use the authenticated user client rather than bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Attachment validation is enforced by the authenticated server endpoint.
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PER_OBJECT=25
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain
